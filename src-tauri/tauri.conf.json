{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freewheel",
  "version": "0.1.0",
  "identifier": "com.brinkercode.freewheel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "freewheel settings", "width": 800, "height": 600 }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "15.0" },
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/brinkercode/freewheel/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
